# Create a Resend API key at https://resend.com/api-keys.
RESEND_API_KEY=re_replace_with_your_key

# The From address must use a domain verified in Resend.
RESEND_FROM_EMAIL="Data Power Analytics <hello@datapoweranalytics.com>"

# Contact form messages are delivered here.
RESEND_TO_EMAIL=hello@datapoweranalytics.com
